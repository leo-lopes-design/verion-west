# dependencies and build output
node_modules/
.next/
out/
dist/
next-env.d.ts
*.tsbuildinfo

# generated by `npm run tokens` on every dev and build
app/tokens.css
tokens/tokens.json
public/artifacts/
angular/src/tokens/

# generated by `npm run build:storybook`
public/storybook/

# Angular workspace caches and library build
angular/.angular/
angular/dist/

# design source files are published separately, not through git
*.fig

# QA captures are reproducible with qa/capture.mjs
qa/screenshots/
qa/measurements-*.json

# large image masters; public/media holds the derived JPEGs the app uses
mockups/

# test build output (qa/verify-personas.mjs)
lib/.personas-build/

# local environment and deploy links
.env*
.vercel/

# editor and OS noise
*.log
.DS_Store
Thumbs.db
*.pem
*.key
